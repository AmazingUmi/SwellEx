# Default: ignore everything not explicitly allowed below.
*

# Repository documentation and source code.
!.gitignore
!.gitattributes
!README.md
!AGENTS.md
!doc/
!doc/**
!scripts_py/
!scripts_py/**
!scripts_matlab/
!scripts_matlab/**
!simulation/
!simulation/**

# Python cache and local environments.
__pycache__/
*.py[cod]
$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# MATLAB generated files.
*.asv
*.m~
*.mex*
*.slxc
*.mlappinstall

# Local editor and OS metadata.
.vscode/
.idea/
.DS_Store
._*
Thumbs.db
desktop.ini

# BELLHOP / KRAKEN simulation outputs (keep .env inputs, .flp, kraken_ref/).
simulation/**/*.arr
simulation/**/*.ray
simulation/**/*.shd
simulation/**/*.mod
simulation/**/*.prt

# Generated data, model checkpoints, plots, and local project assets.
outputs/
environments/
events/
positions/
source/
