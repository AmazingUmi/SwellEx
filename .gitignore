# Default: ignore everything not explicitly allowed below.
*

# Repository documentation and source code.
!.gitignore
!.gitattributes
!README.md
!AGENTS.md
!doc/
!doc/**
!notebooks/
!notebooks/**
!scripts/
!scripts/**
!pyproject.toml
!uv.lock
!.python-version
!simulation/
!simulation/**

# Retired code/docs/notebooks are tracked; archived bulk results (archive/output) are not.
!archive/
!archive/**
archive/output/*
!archive/output/README.md

# Python cache and local environments.
__pycache__/
*.py[cod]
$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# MATLAB generated files.
*.asv
*.m~
*.mex*
*.slxc
*.mlappinstall

# Local editor and OS metadata.
.vscode/
.idea/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
**/.ipynb_checkpoints/**
.DS_Store
._*
Thumbs.db
desktop.ini

# BELLHOP / KRAKEN simulation outputs (keep .env inputs, .flp, kraken_ref/).
simulation/**/*.arr
simulation/**/*.ray
simulation/**/*.shd
simulation/**/*.mod
simulation/**/*.prt

# Generated data, model checkpoints, plots, and local project assets.
outputs/
environments/
events/
positions/
source/

# Agents configurations and logs (keep .env inputs).
.agents/

# The raw-input ignore rules above also match archive/source; keep the snapshots tracked.
!archive/source/
